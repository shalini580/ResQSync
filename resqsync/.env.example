# Copy this file to .env and change what you need.

# auto   = try MySQL first, use the SQLite file if MySQL can't be reached
# mysql  = MySQL only (stop with an error if it fails)
# sqlite = skip MySQL, always use data/resqsync.db
DB_ENGINE=auto

# MySQL login (only used when DB_ENGINE is auto or mysql)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=resqsync_final

# SQLite file (fallback)
DB_FILE=data/resqsync.db

PORT=3000
JWT_SECRET=

# allocator: 2 worker threads, ready queue holds 8, each allocation takes 2 s so you can watch it
ALLOCATOR_WORKERS=2
QUEUE_CAPACITY=8
WORK_DELAY_MS=2000
# a waiting case moves up one priority level every 30 s (aging)
AGING_MS=30000
# false = admin presses "Allocate by priority", true = allocate as soon as a case comes in
AUTO_ALLOCATE=false

# queue order inside the same priority: score = RISK_WEIGHT x ML risk + DISTANCE_WEIGHT x nearness to the depot
RISK_WEIGHT=0.6
DISTANCE_WEIGHT=0.4
# ML risk at or above this moves a case up one priority level
ML_PROMOTE_AT=0.85

# backups: folder, automatic backup every N hours (0 = off), how many files to keep
BACKUP_DIR=data/backups
BACKUP_EVERY_HOURS=24
BACKUP_KEEP=10

# expired surplus food is moved to surplus_food_archive this many hours after expiry, checked every N minutes (0 = admin button only)
ARCHIVE_AFTER_HOURS=6
ARCHIVE_EVERY_MINUTES=60

# stock forecast: average use over the last N hours
FORECAST_HOURS=6

# Shared password for demo accounts seeded on first startup
RESQSYNC_DEMO_PASSWORD=
