# Copy this file to .env and change what you need.

# auto   = try MySQL first, use the SQLite file if MySQL can't be reached
# mysql  = MySQL only (stop with an error if it fails)
# sqlite = skip MySQL, always use data/resqsync.db
DB_ENGINE=auto

# MySQL login (only used when DB_ENGINE is auto or mysql)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=resqsync_final

# SQLite file (fallback)
DB_FILE=data/resqsync.db

PORT=3000
JWT_SECRET=change-this-to-any-long-random-text

# allocator: 2 worker threads, ready queue holds 8, each allocation takes 2 s so you can watch it
ALLOCATOR_WORKERS=2
QUEUE_CAPACITY=8
WORK_DELAY_MS=2000
# a waiting case moves up one priority level every 30 s (aging)
AGING_MS=30000
# false = admin presses "Allocate by priority", true = allocate as soon as a case comes in
AUTO_ALLOCATE=false
